# Sink Docker deployment — copy this file to the repo root as `.env`, then edit.
# `docker compose` reads `.env` automatically and injects these as container env vars.
# (`.env` is git-ignored and excluded from the Docker build context — never commit it.)

# REQUIRED — dashboard login password and API password.
# >= 8 characters, keep it stable (changing it after data exists is fine).
NUXT_SITE_TOKEN=replace-me-with-a-strong-password

# Prebuilt image to run (GHCR by default; set to your own repo, or your ACR if you
# pushed there instead). Only needed if the repo isn't the default in compose.
#SINK_IMAGE=ghcr.io/wan463721262-lang/sink:latest

# --- Optional runtime settings ---
# Analytics dataset name (default "sink").
NUXT_DATASET=sink

# Usage analytics from Cloudflare (optional). These ARE external calls to the
# Cloudflare GraphQL API — leave empty to keep the instance fully local.
#NUXT_CF_ACCOUNT_ID=
#NUXT_CF_API_TOKEN=

# Where the root "/" redirects (leave empty to show the landing page).
NUXT_HOME_URL=
# Where unknown short links redirect (leave empty for a 404 page).
NUXT_NOT_FOUND_REDIRECT=

# Redirect HTTP status code (301 or 302).
NUXT_REDIRECT_STATUS_CODE=301
# Append the incoming query string to the redirect target.
NUXT_REDIRECT_WITH_QUERY=false
# Set Cache-Control: no-store on redirects.
NUXT_REDIRECT_NO_STORE=false
# Edge cache TTL (seconds) for link lookups.
NUXT_LINK_CACHE_TTL=60
# Case-sensitive slugs (default false).
NUXT_CASE_SENSITIVE=false
# Skip logging visits from known bots.
NUXT_DISABLE_BOT_ACCESS_LOG=false
# Disable the daily auto-backup task (local mode has no cron anyway).
NUXT_DISABLE_AUTO_BACKUP=false
